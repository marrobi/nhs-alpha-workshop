@{
    ViewData["Title"] = "Register as a new orderer on an existing ImmForm account";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-xl">Register as a new orderer on an existing ImmForm account</h1>

        <p class="govuk-body-l">
            Use this service to register as a new orderer on an existing ImmForm account.
        </p>

        <h2 class="govuk-heading-m">What you will need</h2>

        <ul class="govuk-list govuk-list--bullet">
            <li>your 10-digit ImmForm account number</li>
            <li>your ImmForm organisation code</li>
            <li>your professional email address (not a shared mailbox)</li>
            <li>your job title</li>
            <li>your telephone number</li>
        </ul>

        <p class="govuk-body">
            The Authorised Person for your account is looked up automatically — you do not need to know who it is.
        </p>

        <p class="govuk-body">
            Once your Authorised Person has approved your registration, your account will be set up within approximately 2 working days.
        </p>

        <a href="/register/applicant-details" role="button" draggable="false"
           class="govuk-button govuk-button--start" data-module="govuk-button">
            Start now
            <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg"
                 width="17.5" height="19" viewBox="0 0 33 40" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
            </svg>
        </a>

        <h2 class="govuk-heading-m">Other ways to register</h2>

        <p class="govuk-body">
            If you cannot use this service online, contact the ImmForm helpdesk at
            <a href="mailto:helpdesk@immform.org.uk" class="govuk-link">helpdesk@immform.org.uk</a>.
        </p>

        <p class="govuk-body">
            If your organisation does not have an ImmForm account,
            <a href="#" class="govuk-link">apply for a new delivery location account</a>.
        </p>
    </div>
</div>
